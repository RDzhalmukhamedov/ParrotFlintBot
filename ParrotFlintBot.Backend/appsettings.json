{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Application": {
    "Name": "Parrot Flint Bot Backend",
    "Version": "1.3"
  },
  "DBConfiguration": {
    "Host": "{DB_HOST}",
    "Port": "{DB_PORT}",
    "DbName": "{DB_NAME}",
    "Username": "{DB_USERNAME}",
    "Password": "{DB_PASSWORD}"
  },
  "RabbitMQConfiguration": {
    "Host": "{RABBIT_HOST}",
    "Port": "{RABBIT_PORT}",
    "Username": "{RABBIT_USERNAME}",
    "Password": "{RABBIT_PASSWORD}",
    "EnableAckConfirmation": "{RABBIT_ACK_CONFIRMATION}",
    "MessageTTL": "{RABBIT_MESSAGE_TTL}",
    "ListenerRouteKeys": {
      "UserActions": "{USER_ACTIONS_ROUTE}",
      "NewCrawledUpdates": "{NEW_UPDATES_ROUTE}"
    },
    "PublisherRouteKeys": {
      "ProjectsToFullCrawl": "{PROJECTS_TO_FULL_CRAWL_ROUTE}",
      "ProjectsToSimpleCrawl": "{PROJECTS_TO_SIMPLE_CRAWL_ROUTE}",
      "UpdatesNotification": "{UPDATES_INFO_ROUTE}",
      "ProjectsList": "{PROJECTS_LIST_ROUTE}"
    }
  },
  "CronConfig": {
    "FullCrawlExpression": "0 12 */2 * *",
    "LiteCrawlExpression": "0 */4 * * *"
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "internalLogLevel": "Info",
    "internalLogFile": "internal-nlog.txt",
    "extensions": [
      { "assembly": "NLog.Extensions.Logging" },
      { "assembly": "NLog.Web.AspNetCore" },
      { "assembly": "Logtail" }
    ],
    "targets": {
      "logtail": {
        "type": "Logtail",
        "layout": "${message}",
        "sourceToken": "{ BETTERSTACK_BACKEND_TOKEN }"
      },
      "logconsole": {
        "type": "Console"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logconsole"
      },
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "logtail"
      }
    ]
  }
}
